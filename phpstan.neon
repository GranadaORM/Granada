parameters:
  level: 5
  paths:
    - src
  ignoreErrors:
    # _for_table() is the query factory: @return static is the API
    # contract and new static() is how subclasses get instantiated.
    # group_query() builds the group closure's fresh query for the
    # same class for the same reason. Finalising constructors to
    # satisfy this would break subclasses that override them.
    -
      identifier: new.static
      path: src/Granada/Query.php
      count: 2
    # Model::create() builds the unsaved row of the class it is
    # called on: @return static is the API contract.
    -
      identifier: new.static
      path: src/Granada/Granada.php
      count: 1
    # The @param string[] docblock is the contract; the is_string() guard
    # deliberately tolerates non-string pieces at this public seam instead
    # of fataling on trim().
    -
      identifier: function.alreadyNarrowedType
      path: src/Granada/Orm/Renderer.php
      count: 1
