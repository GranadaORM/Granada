parameters:
  level: 5
  paths:
    - src
  ignoreErrors:
    # _for_table() is the Active Record factory: @return static is the API
    # contract and new static() is how subclasses get instantiated. Row
    # instances are created through _create_instance_from_row() for the
    # same reason: they must match the query's class. _group_query()
    # builds the group closure's fresh query for the same class for the
    # same reason. Finalising constructors to satisfy this would break
    # subclasses that override them.
    -
      identifier: new.static
      path: src/Granada/ORM.php
      count: 3
    # The @param string[] docblock is the contract; the is_string() guard
    # deliberately tolerates non-string pieces at this public seam instead
    # of fataling on trim().
    -
      identifier: function.alreadyNarrowedType
      path: src/Granada/Orm/Renderer.php
      count: 1
